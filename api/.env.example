# Copy to api/.env and fill in real values. Never commit api/.env.
ENVIRONMENT=development
ANTHROPIC_API_KEY=sk-ant-your-key-here
COMPANIES_HOUSE_API_KEY=your-companies-house-key-here

# Postgres (local: `uv run python scripts/local_db.py start`, or docker compose up -d)
DATABASE_URL=postgresql+psycopg://tallied@127.0.0.1:55432/tallied
CORS_ORIGINS=http://localhost:3000

# AI fallback (photos, scans, unusual layouts)
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# Cost safety net: total Claude calls allowed per UTC day, across all checks
AI_DAILY_CALL_CAP=200

# Upload limits
MAX_FILES=12
MAX_FILE_MB=10
MAX_PAGES=30

# Privacy and abuse limits
REPORT_TTL_HOURS=24
CHECKS_PER_IP_PER_DAY=3
# Long random secret; IPs are stored only as HMAC hashes with this salt
RATE_LIMIT_SALT=replace-with-a-long-random-string
# Set true only behind a proxy you control (Railway), so X-Forwarded-For can be trusted
TRUST_PROXY_HEADERS=false
# Uploads are written only here and deleted after processing (default: <system temp>/tallied-uploads)
# UPLOAD_TEMP_DIR=
CLEANUP_INTERVAL_MINUTES=10
