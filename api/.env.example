# Copy to api/.env and fill in real values. Never commit api/.env.
ENVIRONMENT=development
ANTHROPIC_API_KEY=sk-ant-your-key-here
COMPANIES_HOUSE_API_KEY=your-companies-house-key-here

# Postgres (local: `uv run python scripts/local_db.py start`, or docker compose up -d).
# On Heroku: set automatically by the Heroku Postgres add-on (postgres://... is fine; the +psycopg driver is added for you).
DATABASE_URL=postgresql+psycopg://tallied@127.0.0.1:55432/tallied
CORS_ORIGINS=http://localhost:3000

# AI fallback (photos, scans, unusual layouts)
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# Cost safety net: total Claude calls allowed per UTC day, across all checks
AI_DAILY_CALL_CAP=200

# Upload limits
MAX_FILES=12
MAX_FILE_MB=10
MAX_PAGES=30

# Privacy and abuse limits
REPORT_TTL_HOURS=24
CHECKS_PER_IP_PER_DAY=3
# Long random secret; IPs are stored only as HMAC hashes with this salt
RATE_LIMIT_SALT=replace-with-a-long-random-string
# Keep false, including behind Heroku's router: visitors' IPs arrive from the web app with WEB_PROXY_SECRET
TRUST_PROXY_HEADERS=false
# Same long random value as WEB_PROXY_SECRET in web/.env.local. In production every request except
# GET /health must carry it (403 otherwise), and the API won't start if it's missing or under 32
# characters. Optional in development. It also lets the web app pass on each visitor's real IP.
WEB_PROXY_SECRET=replace-with-another-long-random-string
# Uploads are written only here and deleted after processing (default: <system temp>/tallied-uploads)
# UPLOAD_TEMP_DIR=
CLEANUP_INTERVAL_MINUTES=10
# Checks processed at once; others wait as "queued". Keep 1 on a 512 MB Heroku Basic dyno.
MAX_CONCURRENT_CHECKS=1
