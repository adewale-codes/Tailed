# Copy to web/.env.local. Never commit .env.local.
# Server-side only: the browser talks to /api/* on this app, never to the API directly.
API_URL=http://localhost:8000
# Same long random value as WEB_PROXY_SECRET in api/.env, so the API can rate-limit per visitor.
WEB_PROXY_SECRET=replace-with-another-long-random-string
# Only when hosting somewhere other than Vercel, behind a proxy that overwrites X-Forwarded-For.
# On Vercel leave this unset (Vercel's own x-real-ip is used).
# TRUST_FORWARDED_FOR=true
